# ─────────────────────────────────────────────────────────────────────────────
# EduTech Frontend (Next.js) — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development.
# Set these same variables in your Vercel project settings for production.
# NEVER commit .env.local to version control (it's in .gitignore).
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# Only add NEXT_PUBLIC_ to values that are safe to be public.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API base URL ──────────────────────────────────────────────────────
# Local dev:  http://localhost:8080
# Production: https://your-backend.onrender.com  (or Railway URL)
NEXT_PUBLIC_API_URL=https://ultima-backend-c3fj.onrender.com